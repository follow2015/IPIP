# 应用配置
# SECRET_KEY / JWT_SECRET_KEY：留空或保持 change-me 占位符时，
# install.sh 会自动生成 64 位随机 hex 注入；生产配置对占位符拒绝启动。
SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ip_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-to-a-different-random-string

# 设备凭据加密密钥（SWITCH_SECRET_KEY）
# ⚠️ FLASK_ENV=production 时 **强制要求非空**：ProductionConfig.validate() 会直接抛
#    "生产环境必须设置SWITCH_SECRET_KEY环境变量"，服务启动即崩（实测：monitor 因此
#    被 systemd 反复拉起 5 次后进入 failed）。留空时 install.sh 会自动生成随机值。
SWITCH_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173

# SSH
ssh_Certificate=
ssh_passphrase=

# 微信（如需微信登录功能）
XCC_SECRET=
WX_SECRET=
WX_APPID=
EncodingAESKey=
WX_TOKEN=

# 设备健康监控
MONITOR_ENABLED=true
MONITOR_INTERVAL_SNMP=60
MONITOR_INTERVAL_BMC=300
MONITOR_TIMEOUT_SECONDS=5
MONITOR_THREAD_POOL_SIZE=20
MONITOR_CONSECUTIVE_FAILURES_THRESHOLD=2
MONITOR_FALLBACK_ROLE=admin
MONITOR_DEVICE_IDS_WHITELIST=

# AI 助手（LLM 接入；env 注入 gunicorn 与 celery worker 两个进程）
# 配置来源二选一，请勿混用：
#   ① 部署级固化（推荐：厂商统一下发，客户界面不可改）：
#      AI_PROVIDER / AI_API_KEY / AI_BASE_URL / AI_MODEL 填非空值 →
#      前端「AI 配置」页对应字段显示"由部署环境变量锁定，不可改"，
#      运行与重启始终以 env 为准，最稳定。
#   ② 界面自助（推荐：客户在界面自行配置）：
#      保持下方 4 个字符串键为空（= 后不留字符）、数值键整行注释 →
#      首次安装后在「系统设置 → AI 配置」页填写，运行时持久化到 Redis
#      （key=ai:config），重启由启动钩子自动恢复，UI 修改不会被还原。
# 注意：切勿照抄占位默认值（openai / gpt-4o-mini）部署——任一键非空即被当作
#       部署级固化并锁定该字段，客户在前端改为 deepseek 等会被拒绝、重启还原。
# 注意：AI_TIMEOUT 等数值键只能整行注释（# 开头），不能留空——
#       空值会让 config.py 的 int()/float() 解析崩溃，进程无法启动。
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
#AI_TIMEOUT=30
#AI_STREAM_TIMEOUT=120
#AI_MAX_TOKENS=2048
#AI_TEMPERATURE=0.3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=30
# RAG 知识库文档根目录：入库时填写的 docs_dir 是**相对它**的子目录，
# '.' 或留空表示本目录本身（如填 monitoring → <本目录>/monitoring）。
# 相对路径按项目根解析；生产建议写绝对路径（如 /opt/ipip/docs），
# 避免后端不从项目根启动时解析到错误位置。改动需重启后端。
AI_DOCS_ROOT=docs
AI_ASYNC_ENABLED=1

# RAG 本地模型（离线部署必需：代码强制 HF_HUB_OFFLINE=1，模型不在本地则加载失败）
# 模型由部署脚本预置到 **HF 标准缓存**（$HF_HOME/hub/models--BAAI--*/snapshots/main/），
# 走 ModelScope 镜像（实测约 5.7MB/s；hf-mirror 仅约 1MB/s）。不要用
# SentenceTransformer('BAAI/...') 直接下载——国内机房访问 huggingface.co 基本不通。
#   bash scripts/install.sh                                        # 安装时自动下载
#   .venv/bin/python scripts/download_models.py                    # 单独下载/断点重试
#   .venv/bin/python scripts/download_models.py --only embedding    # 仅必需项（约 92MB）
# 与本机开发环境（~/.cache/huggingface）共用同一套缓存解析机制，故下面的 repo id
# 保持原样即可，无需改成路径。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=False
RAG_EMBEDDING_PROVIDER=local_bge
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512

# RAG 本地 rerank 精排（检索最后一环：RRF 融合后再用 cross-encoder 精排）。
# 代码默认启用（1）；模型由 scripts/download_models.py 预置到 HF 标准缓存后即可用，
# 模型缺失/加载失败自动降级为 RRF 排序、不影响检索。无模型环境可设 0 关闭。
RAG_RERANK_ENABLED=1
#RAG_RERANK_MODEL=BAAI/bge-reranker-base   # 可选：换模型（如 v2-m3）
#RAG_RERANK_CANDIDATES=30                   # 可选：参与精排的候选数上限

# Celery（AI 长任务异步执行，broker db1 / result backend db2 分离）
# 必须与 REDIS_HOST 指向同一个**可达**的 Redis：
# 本地无 Redis 时（默认模板的 localhost）入队会直接失败，前端表现为入库无进展。
# 有密码时用 redis://:<password>@<host>:<port>/<db> 格式；
# 改完需重启后端与 Celery worker（bash scripts/start.sh restart）。
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=2
CELERY_LOGLEVEL=info

# SSE 实时推送（seq/ring 已迁至 Redis 共享，网关可多副本部署；由发布侧 switch_events.py 读取）
SSE_RING_BUFFER_SIZE=200
SSE_RING_TTL_SECONDS=3600

# HTTPS 强制（登录密码为明文 JSON 传输，安全性依赖 TLS）。
# 部署在 TLS 反代之后时设为 true，非 HTTPS 请求将被 400 拒绝（/api/health 探活豁免）。
# 若经反代终止 TLS，须同步设置 TRUSTED_PROXIES=反代IP，否则 X-Forwarded-Proto 不被采信。
# 默认留空=不强制（保持 HTTP 直连可用）。
#ENFORCE_HTTPS=true
#TRUSTED_PROXIES=

# ── Prometheus 抓取端点（/metrics，AI 聚合指标 + 进程指标）────────────────
# 默认开启且免鉴权，适合内网直抓；对外网部署务必同时开启下列两项！
# METRICS_ENABLED=false：完全不注册该路由（对外 404）。
# METRICS_TOKEN 非空：抓取须带 ?token=<值> 或 Authorization: Bearer <值>。
# METRICS_ALLOWED_IPS：来源 IP 白名单（逗号分隔的 IP/CIDR），与口令叠加生效；
#       配置后仅白名单来源可抓取。公网部署务必填写（如抓取机 IP）。
# 注意：ai_* 是跨进程聚合值，多 worker 抓取会得到 N 条同值序列，
#       PromQL 请用 max()/avg()/topk(1,...)，不要用 sum()。
#METRICS_ENABLED=true
#METRICS_TOKEN=
#METRICS_ALLOWED_IPS=

# ── 企业身份集成（LDAP/AD，只读透传 Bind；T3）────────────────────────────
# 默认关闭：以下各项全不配时，本地账号登录行为完全不变（auth_source=local）。
# 开启后：登录密码**原样透传**到域控做 Bind 校验，不做密码同步、不落库明文。
# 生产环境开启但缺 LDAP_SERVER / LDAP_BASE_DN 时，服务启动即报错（fail-fast）。
#LDAP_ENABLED=true
#LDAP_SERVER=ldaps://dc.corp.local:636
#LDAP_BASE_DN=DC=corp,DC=local
# 检索用户/组的服务账号；其密码建议经 /etc/ipip/ipip.env 注入，勿写入仓库
#LDAP_BIND_DN=CN=svc-ipip,OU=Service,DC=corp,DC=local
#LDAP_BIND_PASSWORD=
# 用户检索过滤器：AD 用 sAMAccountName，OpenLDAP 常用 uid
#LDAP_USER_FILTER=(sAMAccountName={username})
#LDAP_TIMEOUT=5
#
# 组→角色映射（T3.5）。留空 = 仅认证走 LDAP，角色仍由管理员在本地维护（推荐起步）。
# 非空 = 角色由目录托管，每次登录按 memberOf 重算（组变更下次登录即生效）。
# 键可以是组的 CN 名，也可以是完整 DN。
# 条目之间用 ; 或 | 或换行；组与角色之间用 =>（推荐，DN 内到处是 =）。
# 也接受 : 或 =，但仅在该条目里恰好出现一次时可用，否则启动期报错。
# ⚠️ 多条映射别用逗号/空格并列：会被当成一条切开，键永远匹配不上 → 全员掉到默认角色。
# 支持 JSON：{"IPIP-Ops": "operator", "CN=Admins,OU=G,DC=corp,DC=local": "admin"}
#LDAP_GROUP_ROLE_MAP=IPIP-Ops=>operator;IPIP-Viewers=>viewer
# 目录组一个都没命中时的兜底角色；留空 = 判为未授权并拒绝登录（fail-close）
#LDAP_DEFAULT_ROLE=
# 首次登录自动建号（会写库，默认关闭）；建号口令为随机不可知值，只能走 LDAP 登录
#LDAP_AUTO_PROVISION=false
# 每次登录按目录组重算角色（仅 LDAP_GROUP_ROLE_MAP 非空时生效）
#LDAP_SYNC_ROLES_ON_LOGIN=true
#
# 应急管理员通道（T3.6）：逗号分隔的本地账号白名单，恒走本地口令、绕过 LDAP。
# 域控故障/被隔离时靠它抢修；**每次使用都会写审计**（action=auth.ldap_bypass）。
# 这些账号务必保持 auth_source=local 且口令由本地维护；留空 = 无应急通道。
# 强烈建议：开启 LDAP 前先配好它，否则域控一挂就没人能进系统。
#LDAP_BYPASS_USERS=ipipadmin
