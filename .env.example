# 应用配置
SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ip_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-to-a-different-random-string

# CORS
CORS_ORIGINS=http://localhost:5173

# SSH
ssh_Certificate=
ssh_passphrase=

# 微信（如需微信登录功能）
XCC_SECRET=
WX_SECRET=
WX_APPID=
EncodingAESKey=
WX_TOKEN=

# 设备健康监控
MONITOR_ENABLED=true
MONITOR_INTERVAL_SNMP=60
MONITOR_INTERVAL_BMC=300
MONITOR_TIMEOUT_SECONDS=5
MONITOR_THREAD_POOL_SIZE=20
MONITOR_CONSECUTIVE_FAILURES_THRESHOLD=2
MONITOR_FALLBACK_ROLE=admin
MONITOR_DEVICE_IDS_WHITELIST=
