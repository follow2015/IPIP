# 应用配置
# SECRET_KEY / JWT_SECRET_KEY：留空或保持 change-me 占位符时，
# install.sh 会自动生成 64 位随机 hex 注入；生产配置对占位符拒绝启动。
SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# 数据库
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ip_management
# ⚠️ 连接容量（A-P1-6）—— 给的是**上界公式**，不是稳态占用：
#    需求上界 = 进程数 × (pool_size + max_overflow) = 进程数 × 30
#      · pool_size=10 / max_overflow=20 是**代码常量**（config.py，不随环境变）；
#      · 进程数来自 deploy/systemd/ipip.env.example 的 GUNICORN_WORKERS 与
#        CELERY_*_CONCURRENCY；默认部署 = 4(gunicorn)+2(celery-ai)+4(celery-voice)
#        +1(monitor) = 11 ⇒ 上界 11 × 30 = 330 条。
#    与 max_connections 的关系：330 是"所有进程把溢出池同时打满"的理论上界，
#    max_overflow 按需创建、用完即还 ⇒ 稳态远低于它。本部署实测（2026-09-22，
#    只读 SHOW VARIABLES / SHOW GLOBAL STATUS）：max_connections=151，
#    历史峰值 Max_used_connections=10 ⇒ **余量充足，当前无需任何调整**。
#    什么时候才真要动：`.venv/bin/python scripts/check_db_pool_capacity.py`
#    报上界 > max_connections，**且**
#    Max_used_connections 已接近上限 —— 看实测，不要按理论值调。
#    调整顺序：先降并发（GUNICORN_WORKERS / CELERY_*_CONCURRENCY），
#    再抬 max_connections（后者要重启库，前者只重启应用）。

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-to-a-different-random-string

# 设备凭据加密密钥（SWITCH_SECRET_KEY）
# ⚠️ FLASK_ENV=production 时 **强制要求非空**：ProductionConfig.validate() 会直接抛
#    "生产环境必须设置SWITCH_SECRET_KEY环境变量"，服务启动即崩（实测：monitor 因此
#    被 systemd 反复拉起 5 次后进入 failed）。留空时安装器（python -m installer
#    的 [4/7] 步）会自动生成随机值。
#
# [WARN] 格式有**硬约束**，不是"够长就行"：这是 AES-256-GCM **数据密钥**，
#    必须恰好 **32 字节**。可接受两种写法：
#      hex    ：64 个 hex 字符（推荐，安装器生成的就是这种）
#               生成：python -c "import secrets;print(secrets.token_hex(32))"
#      base64 ：44 字符（标准表或 URL-safe 表都认）
#    ⚠️ 常见误区：**64 字符的 base64 串不是 32 字节，而是 48 字节**（字符串长度
#    不等于解码后字节数）。用 `openssl rand -base64 32` 才是 44 字符。
#    填错不会启动失败（校验只在第一次加解密时触发），表现是"加设备凭据报
#    服务器内部错误"—— 见 docs/ops/运维手册-密钥与环境变量.md 第三节·补。
SWITCH_SECRET_KEY=

# 备份密钥导出：整机损毁后 SWITCH_SECRET_KEY 只能靠 <备份目录>/secrets.env.gpg 恢复，
# 解密口令是 GPG_PASSPHRASE —— **刻意不写在本文件**，而是 /etc/ipip/ipip.env
# （备份单元经 systemd EnvironmentFile 读取，模板见 deploy/systemd/ipip.env.example）。
# 手工跑 scripts/backup_system.py --include-secrets 时用环境变量传入即可。

# CORS
CORS_ORIGINS=http://localhost:5173

# SSH
ssh_Certificate=
ssh_passphrase=

# 微信（如需微信登录功能）
XCC_SECRET=
WX_SECRET=
WX_APPID=
EncodingAESKey=
WX_TOKEN=

# 设备健康监控
MONITOR_ENABLED=true
MONITOR_INTERVAL_SNMP=60
# ⚠️ BMC 与其它协议同为 60 s（单一真源 protocol_registry.DEFAULT_LOOP_INTERVALS）：
#    节奏不统一会让指标时间错位。本行旧值 300 已清理（2026-09-21）。
MONITOR_INTERVAL_BMC=60
MONITOR_TIMEOUT_SECONDS=5
# 单个轮询循环的并发上限；全部 loop 共用一个进程级共享池，总并发还受下面
# 的 MONITOR_MAX_DB_CONCURRENCY 封顶（4 loop × 20 = 80 ≫ 连接池 30 的历史问题）。
MONITOR_THREAD_POOL_SIZE=20
# 监控线程能同时占用的 DB 连接上限。DB 池是 10+20=30，默认 24 留 6 条给 web 请求。
MONITOR_MAX_DB_CONCURRENCY=24
MONITOR_CONSECUTIVE_FAILURES_THRESHOLD=2
MONITOR_FALLBACK_ROLE=admin
MONITOR_DEVICE_IDS_WHITELIST=

# 告警事件聚合（incident，L1/L2/L3 三层归并；设计见 docs/design/事件自动关闭规则-设计说明-20261008.md）
# ⚠️ 以下 5 项在 2026-10-08 前**只存在于 config.py，未登记本文件**（既有缺口，本次补登）。
MONITOR_INCIDENT_ENABLED=true
# L1 归并时间窗秒：同一 (告警类型, 设备) 在该窗内重复告警并入同一事件，而非新建。
MONITOR_INCIDENT_WINDOW=300
# L3 变更回溯窗秒：事件创建前后该窗内的设备配置变更会被关联为疑似根因。
MONITOR_INCIDENT_CHANGE_WINDOW=300
# 事件自动关闭（停滞清扫）：活跃事件超过 N 小时无新告警即归档关闭（<=0 停用该规则）。
# ⚠️ N 必须**严格大于**设备重告警间隔，否则会误关仍在故障中的事件：清扫判据是
#    `last_alert_at < now - N`，而 last_alert_at 只在有新告警时刷新 ⇒ 两次重告警之间
#    的静默期若超过 N，故障未恢复的事件也会被关掉。
#    重告警间隔 = `MONITOR_REALERT_INTERVAL_MINUTES`（**动态配置项、不是环境变量**，
#    在「监控中心 → 运行配置」改），默认 360 分钟 = 6h ⇒ 默认 N=24h 为 4 倍余量。
#    ⚠️ 该动态配置上限 1440 分钟 = 24h，**正好等于本默认值** ⇒ 调到上限即与清扫同周期
#    赛跑。调大重告警间隔前必须先调大 N，两者耦合。
MONITOR_INCIDENT_AUTOCLOSE_HOURS=24
# 清扫最小间隔秒：outbox 发件线程每 5s 轮一转，无闸会白打一次 UPDATE。
MONITOR_INCIDENT_AUTOCLOSE_INTERVAL=600

# 通知投递并发数（B-40：每进程一个投递池；一台慢 SMTP 只占 1 个池线程，
# 其余线程继续投别的通知）。上限受 DB 连接池约束（pool_size+max_overflow=30，
# 每个池线程最多占 1 条连接），4 留足余量给 web 请求。0/负数/非法值回退 4。
NOTIFICATION_DELIVERY_WORKERS=4

# SNMP Trap 接收（P1-1，独立服务 ipip-trapd；不部署该 unit 时以下配置无效）
#
# ⚠️ 启用方式已变更：**不要**靠改这里 + restart。trapd 进程常驻待机，
#    收/不收由「动态配置」决定（前端 监控中心 → 运行配置 → SNMP Trap 接收，
#    等价 API：PUT /api/monitor/config {"updates":{"TRAPD_ENABLED":true}}）。
#    未开启时不监听端口、不占资源、不报错；配置非法也只阻断监听、不退出进程
#    （避免 systemd Restart=on-failure 重启风暴）。下列各项仅作
#    「动态配置里没有该 key」时的兜底初值。
# TRAPD_ENABLED=true
# 端口 162 为特权端口：root 运行或 CAP_NET_ADMIN；无特权用 10162 并在交换机
# 侧把 trap 目标端口指过来（snmp-server host <ip> <community> <port>）。
#TRAPD_LISTEN_ADDRESS=0.0.0.0
#TRAPD_LISTEN_PORT=10162
# 允许接收的 community（逗号分隔）。SNMPv1/v2c 的 community 是唯一凭据。
# 留空时回退到凭据库里**启用中的 SNMP 凭据**（加密存储、默认不回显）——多数
# 情况无需手工填。若仍为空、或写成知名默认值（public/private，大小写不敏感），
# 则**拒绝监听**（不退出进程，记 _last_error 等待配置改正后自动恢复）。
# 校验在收包循环内做（解码后、入队前），不匹配的报文不进处理链。
#
# ⚠️ 版本支持现状：trapd **仅支持 SNMPv1/v2c**，**尚不支持 SNMPv3（USM authPriv）**。
#    交换机侧若只配了 v3 trap 目标（`snmp-agent target-host ... v3 ...`），
#    当前 trapd **收不到**（只配 v3 凭据时会报"未找到可用的 SNMP community"而拒绝监听）。
#    此时需在交换机侧**临时改配 v2c**，或等待 trapd 的 v3 支持落地。
#    现场实测与改造设计见：
#      docs/ops/2026-10-06-SNMPv3-Trap-现场实测与解密验证.md
#      docs/design/trapd-SNMPv3支持-设计文档-20261006.md
#    排查工具（不改代码即可确认"报文到了没/什么级别"）：
#      python scripts/probes/snmp_v3_trap_probe.py 300
#      python scripts/probes/snmp_v3_trap_decrypt_probe.py --cred-id <id> --sample <报文.bin>
#TRAPD_COMMUNITIES=
# 源 IP 白名单（逗号分隔，支持单 IP 与 CIDR，如 10.0.0.0/8,192.168.1.5）。
# 留空 = 不启用。UDP 源 IP 可伪造，而设备关联正是按源 IP 反查 —— 强烈建议显式
# 限定为交换机管理网段。写法非法（非 IP / 掩码越界）时**拒绝监听**（同上，不退出）。
#TRAPD_SOURCE_ALLOWLIST=
# 逃生舱：显式允许弱 community（仅限实验/隔离内网联调）。生产必须保持 false。
#TRAPD_ALLOW_WEAK_COMMUNITY=false
# ── SNMPv3 Trap（默认关；开启前请确认交换机侧已配 v3 trap 目标）────────
#TRAPD_V3_ENABLED=false
# v3 用户名白名单（逗号分隔）。留空 = 用凭据库里**全部启用中的 v3 凭据**
# （多数情况无需手工填）。显式指定则只接受这些 username；写了名字但凭据库里
# 没有对应启用 v3 凭据时，trapd 会**告警**该用户名（而不是等到收包时才表现为
# "v3 trap 全被拒"）。
#TRAPD_V3_USERS=
# 全局限流（条/分钟，防 trap 风暴）
#TRAPD_RATE_LIMIT_PER_MINUTE=120
# 站点自定义规则（JSON 数组；厂商电源/风扇/温度/BGP 等 OID 按厂商 MIB 补充）
# 字段：name/match_oid/severity(info|warning|critical)/title/content/index_varbind(可选)
# match_oid 支持前缀匹配（写企业 OID 前缀命中整族）；index_varbind 建议写列 OID
# 前缀（如 ifIndex 列 1.3.6.1.2.1.2.2.1.1），取尾段实例号做去重隔离。
# 示例（Cisco 电源故障，示意）：
#TRAP_CUSTOM_RULES=[{"name":"psu_failure","match_oid":"1.3.6.1.4.1.9.9.13.1.5","severity":"critical","title":"电源故障","content":"设备上报电源模块故障","index_varbind":"1.3.6.1.4.1.9.9.13.1.5.1"}]

# AI 助手（LLM 接入；env 注入 gunicorn 与 celery worker 两个进程）
# 配置来源二选一，请勿混用：
#   ① 部署级固化（推荐：厂商统一下发，客户界面不可改）：
#      AI_PROVIDER / AI_API_KEY / AI_BASE_URL / AI_MODEL 填非空值 →
#      前端「AI 配置」页对应字段显示"由部署环境变量锁定，不可改"，
#      运行与重启始终以 env 为准，最稳定。
#   ② 界面自助（推荐：客户在界面自行配置）：
#      保持下方 4 个字符串键为空（= 后不留字符）、数值键整行注释 →
#      首次安装后在「系统设置 → AI 配置」页填写，运行时持久化到 Redis
#      （key=ai:config），重启由启动钩子自动恢复，UI 修改不会被还原。
# 注意：切勿照抄占位默认值（openai / gpt-4o-mini）部署——任一键非空即被当作
#       部署级固化并锁定该字段，客户在前端改为 deepseek 等会被拒绝、重启还原。
# 注意：AI_TIMEOUT 等数值键只能整行注释（# 开头），不能留空——
#       空值会让 config.py 的 int()/float() 解析崩溃，进程无法启动。
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
#AI_TIMEOUT=30
#AI_STREAM_TIMEOUT=120
#AI_MAX_TOKENS=2048
#AI_TEMPERATURE=0.3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=30
# RAG 知识库文档根目录：入库时填写的 docs_dir 是**相对它**的子目录，
# '.' 或留空表示本目录本身（如填 monitoring → <本目录>/monitoring）。
# 相对路径按项目根解析；生产建议写绝对路径（如 /opt/ipip/docs），
# 避免后端不从项目根启动时解析到错误位置。改动需重启后端。
AI_DOCS_ROOT=docs
AI_ASYNC_ENABLED=1

# RAG 本地模型（离线部署必需：代码强制 HF_HUB_OFFLINE=1，模型不在本地则加载失败）
# 模型由部署脚本预置到 **HF 标准缓存**（$HF_HOME/hub/models--BAAI--*/snapshots/main/），
# 走 ModelScope 镜像（实测约 5.7MB/s；hf-mirror 仅约 1MB/s）。不要用
# SentenceTransformer('BAAI/...') 直接下载——国内机房访问 huggingface.co 基本不通。
#   bash scripts/install.sh                                        # 安装时自动下载
#   .venv/bin/python scripts/download_models.py                    # 单独下载/断点重试
#   .venv/bin/python scripts/download_models.py --only embedding    # 仅必需项（约 92MB）
# 与本机开发环境（~/.cache/huggingface）共用同一套缓存解析机制，故下面的 repo id
# 保持原样即可，无需改成路径。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=False
RAG_EMBEDDING_PROVIDER=local_bge
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512

# RAG 本地 rerank 精排（检索最后一环：RRF 融合后再用 cross-encoder 精排）。
# 代码默认启用（1）；模型由 scripts/download_models.py 预置到 HF 标准缓存后即可用，
# 模型缺失/加载失败自动降级为 RRF 排序、不影响检索。无模型环境可设 0 关闭。
RAG_RERANK_ENABLED=1
#RAG_RERANK_MODEL=BAAI/bge-reranker-base   # 可选：换模型（如 v2-m3）
#RAG_RERANK_CANDIDATES=30                   # 可选：参与精排的候选数上限

# Celery（AI 长任务异步执行，broker db1 / result backend db2 分离）
# 必须与 REDIS_HOST 指向同一个**可达**的 Redis：
# 本地无 Redis 时（默认模板的 localhost）入队会直接失败，前端表现为入库无进展。
# 有密码时用 redis://:<password>@<host>:<port>/<db> 格式；
# 改完需重启后端与 Celery worker（bash scripts/start.sh restart）。
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=2
CELERY_LOGLEVEL=info

# SSE 实时推送（seq/ring 已迁至 Redis 共享，网关可多副本部署；由发布侧 switch_events.py 读取）
SSE_RING_BUFFER_SIZE=200
SSE_RING_TTL_SECONDS=3600

# HTTPS 强制（登录密码为明文 JSON 传输，安全性依赖 TLS）。
# 部署在 TLS 反代之后时设为 true，非 HTTPS 请求将被 400 拒绝（/api/health 探活豁免）。
# 若经反代终止 TLS，须同步设置 TRUSTED_PROXIES=反代IP，否则 X-Forwarded-Proto 不被采信。
# 默认留空=不强制（保持 HTTP 直连可用）。
#ENFORCE_HTTPS=true
#TRUSTED_PROXIES=

# ── Prometheus 抓取端点（/metrics，AI 聚合指标 + 进程指标）────────────────
# 默认开启且免鉴权，适合内网直抓；对外网部署务必同时开启下列两项！
# METRICS_ENABLED=false：完全不注册该路由（对外 404）。
# METRICS_TOKEN 非空：抓取须带 ?token=<值> 或 Authorization: Bearer <值>。
# METRICS_ALLOWED_IPS：来源 IP 白名单（逗号分隔的 IP/CIDR），与口令叠加生效；
#       配置后仅白名单来源可抓取。公网部署务必填写（如抓取机 IP）。
# 注意：ai_* 是跨进程聚合值，多 worker 抓取会得到 N 条同值序列，
#       PromQL 请用 max()/avg()/topk(1,...)，不要用 sum()。
# ⚠️ 生产环境（FLASK_ENV 未设也按 production 解析）默认开启该端点 —— 故
#    **必须至少配置一项限制**（`ProductionConfig.validate()` 会拒绝启动）：
#    METRICS_TOKEN 或 METRICS_ALLOWED_IPS。内网直抓最省事的做法是填抓取机/网段：
#      METRICS_ALLOWED_IPS=127.0.0.1/32,10.0.8.0/24
#    （确实不需要该端点则设 METRICS_ENABLED=false。）
#METRICS_ENABLED=true
#METRICS_TOKEN=
#METRICS_ALLOWED_IPS=

# ── 企业身份集成（LDAP/AD，只读透传 Bind；T3）────────────────────────────
# 默认关闭：以下各项全不配时，本地账号登录行为完全不变（auth_source=local）。
# 开启后：登录密码**原样透传**到域控做 Bind 校验，不做密码同步、不落库明文。
# 生产环境开启但缺 LDAP_SERVER / LDAP_BASE_DN 时，服务启动即报错（fail-fast）。
#LDAP_ENABLED=true
#LDAP_SERVER=ldaps://dc.corp.local:636
# 传输安全（二选一，两者都不满足时**启动即失败**，不会带病明文跑）：
#   ① LDAP_SERVER 用 ldaps://（推荐的全程 TLS）；或
#   ② LDAP_SERVER 用 ldap:// 且设 LDAP_STARTTLS=true（bind 前协商升级）。
# 明文 ldap:// 且未开 StartTLS 会把域控服务账号口令与用户口令明文暴露在内网。
#LDAP_STARTTLS=false
# 企业 CA 证书（PEM 路径）。留空 = 用系统信任库。
# 服务已强制证书链校验（CERT_REQUIRED）；但 ldap3 2.9.1 强制关闭主机名校验，
# 信任锚为公共 CA 时仍可被持任意受信证书者 MITM —— 企业场景**强烈建议**指向自家 CA。
#LDAP_CA_FILE=
# 逃生舱：允许明文传输凭据。**仅限「尚未配 TLS 的试验目录」联调**，生产必须 false。
# 开启后服务每次认证都会记 WARNING，`flask ldap-check` 也会持续报出。
#LDAP_ALLOW_INSECURE_TRANSPORT=false
#LDAP_BASE_DN=DC=corp,DC=local
# 检索用户/组的服务账号；其密码建议经 /etc/ipip/ipip.env 注入，勿写入仓库
#LDAP_BIND_DN=CN=svc-ipip,OU=Service,DC=corp,DC=local
#LDAP_BIND_PASSWORD=
# 用户检索过滤器：AD 用 sAMAccountName，OpenLDAP 常用 uid
#LDAP_USER_FILTER=(sAMAccountName={username})
#LDAP_TIMEOUT=5
#
# 组→角色映射（T3.5）。留空 = 仅认证走 LDAP，角色仍由管理员在本地维护（推荐起步）。
# 非空 = 角色由目录托管，每次登录按 memberOf 重算（组变更下次登录即生效）。
# 键可以是组的 CN 名，也可以是完整 DN。
# 条目之间用 ; 或 | 或换行；组与角色之间用 =>（推荐，DN 内到处是 =）。
# 也接受 : 或 =，但仅在该条目里恰好出现一次时可用，否则启动期报错。
# ⚠️ 多条映射别用逗号/空格并列：会被当成一条切开，键永远匹配不上 → 全员掉到默认角色。
# 支持 JSON：{"IPIP-Ops": "operator", "CN=Admins,OU=G,DC=corp,DC=local": "admin"}
#LDAP_GROUP_ROLE_MAP=IPIP-Ops=>operator;IPIP-Viewers=>viewer
# 目录组一个都没命中时的兜底角色；留空 = 判为未授权并拒绝登录（fail-close）
#LDAP_DEFAULT_ROLE=
# 首次登录自动建号（会写库，默认关闭）；建号口令为随机不可知值，只能走 LDAP 登录
#LDAP_AUTO_PROVISION=false
# 每次登录按目录组重算角色（仅 LDAP_GROUP_ROLE_MAP 非空时生效）
#LDAP_SYNC_ROLES_ON_LOGIN=true
#
# 应急管理员通道（T3.6）：逗号分隔的本地账号白名单，恒走本地口令、绕过 LDAP。
# 域控故障/被隔离时靠它抢修；**每次使用都会写审计**（action=auth.ldap_bypass）。
# 这些账号务必保持 auth_source=local 且口令由本地维护；留空 = 无应急通道。
# 强烈建议：开启 LDAP 前先配好它，否则域控一挂就没人能进系统。
#LDAP_BYPASS_USERS=ipipadmin
#
# 时序存储后端（ClickHouse；>300 台才需要考虑，默认全走 MySQL）
# 设计依据 docs/design/监控时序存储-统一设计与施工方案-20261005.md §5.1 / §9。
# 键名：CLICKHOUSE_URL 优先；否则由 HOST+PORT 拼（HOST 不带 http:// 前缀）。
#CLICKHOUSE_HOST=127.0.0.1
#CLICKHOUSE_PORT=8123
#CLICKHOUSE_USER=default
#CLICKHOUSE_PASSWORD=
# ⚠️ 必须显式给库名：不设时客户端会落到服务端的 `default` 库。
#CLICKHOUSE_DB=ipip_monitor
# ⚠️ 两条**实测**硬规则（2026-09-21；只读预检脚本 scripts/probes/ch_env_precheck.py）：
#   1) 客户端走 urllib3 ⇒ **HTTP_PROXY / HTTPS_PROXY / ALL_PROXY 会被继承**，请求被以
#      绝对形式发给代理后查询体丢失，CH 侧只回 `404 There is no handle`（看着像
#      鉴权/路由错，实为代理吃掉了查询）。请把 CH 主机写进 NO_PROXY。
#   2) 写入必须传 **tz-aware** datetime：naive datetime 会被按**客户端本地时区**
#      解释（走 Python 的 datetime.timestamp() 语义），+08 机器上整体偏 8 小时；
#      读回是 naive（按列声明 TZ 解读），调用方须自行补 tz。

# ════════════════════════════════════════════════════════════════════
# ⚠️ 生产必填清单与 BREAKING CHANGES（WP-4，2026-09-23）
# ════════════════════════════════════════════════════════════════════
# 存量部署升级后，ProductionConfig.validate 的 fail-fast 硬校验会在重启时
# **拒绝启动**（gunicorn/celery 全体单元连环失败）。重启前先跑离线预检：
#
#     .venv/bin/python scripts/precheck_prod_config.py --env-file /path/to/env
#
# 退出 0 才执行 systemctl restart。以下是会被拒绝启动的项（全量）：
#
# 【必填】
#   SECRET_KEY / JWT_SECRET_KEY     两把不同且非 change-me 的随机串（openssl rand -hex 32）
#   SWITCH_SECRET_KEY               设备凭据加密密钥 —— ⚠️ 丢失则密文永久不可解
#   CORS_ORIGINS                    明确域名列表，不允许 *
#
# 【条件必填】（开关打开才校验）
#   METRICS_ENABLED=true ⇒          METRICS_TOKEN 与 METRICS_ALLOWED_IPS 至少一项
#   LDAP_ENABLED=true ⇒             LDAP_CA_FILE 必须显式指定（企业 CA PEM 路径）
#   FLASK_DEBUG=true ⇒              生产拒绝启动（须为 false）
#
# 【BREAKING CHANGES 历史】
#   A-P2-4（WP-4 之前）：/metrics 无 token+白名单、双密钥相同、LDAP 缺 CA
#     三项由 warn 升级为拒绝启动；SECRET_KEY==JWT_SECRET_KEY 生产禁止。
