# ============================================================
# ipip 部署环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env 后按实际填写
# install.sh 首次运行会自动从本文件拷贝并提示编辑
# ============================================================

# ── 应用配置 ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=production

# ── 数据库 (MySQL 8.4+) ───────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ip_tool
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ip_manager
MYSQL_CHARSET=utf8mb4

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-string

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── SSH（设备登录凭证，按需填写）─────────────────────────
ssh_Certificate=
ssh_passphrase=

# ── 微信小程序（如需微信登录，否则留空）──────────────────
XCC_APPID=
XCC_SECRET=
WX_APPID=
WX_SECRET=
WX_TOKEN=
EncodingAESKey=

# ── 设备健康监控 ──────────────────────────────────────────
MONITOR_ENABLED=true
MONITOR_INTERVAL_SNMP=60
MONITOR_INTERVAL_BMC=300
MONITOR_TIMEOUT_SECONDS=5
MONITOR_THREAD_POOL_SIZE=20
MONITOR_CONSECUTIVE_FAILURES_THRESHOLD=2
MONITOR_FALLBACK_ROLE=admin
MONITOR_DEVICE_IDS_WHITELIST=
# 独立监控进程部署时，Flask HTTP 进程设 false 避免重复探测
MONITOR_WORKER_IN_PROCESS=false

# ── 日志 ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── 代理与白名单 ──────────────────────────────────────────
TRUSTED_PROXIES=['127.0.0.1', 'localhost']
ALLOWED_DOMAINS=['127.0.0.1', 'localhost']
