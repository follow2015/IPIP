Value IP_ADDRESS (\d+\.\d+\.\d+\.\d+)
Value MAC_ADDRESS ([0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4})
Value VLAN (\d+|N/A)
Value INTERFACE (\S+)
Value TYPE (\S+)
Value AGING (\d+|-)

Start
  ^${IP_ADDRESS}\s+${MAC_ADDRESS}\s+${VLAN}\s+${INTERFACE}\s+${AGING}\s+${TYPE} -> Record
  ^${IP_ADDRESS}\s+Incomplete\s+${VLAN}\s+${INTERFACE}\s+${AGING}\s+${TYPE} -> Record
  ^\s*IP\s+Address -> Continue
  ^\s*-+ -> Continue