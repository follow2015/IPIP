{
  "name": "ipip-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:circular": "node scripts/check-circular-deps.mjs",
    "check:circular:static": "node scripts/check-circular-deps.mjs --static-only",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,js,cjs,json,md}\"",
    "generate:types": "openapi-typescript ../openapi.json -o src/types/api-generated.ts",
    "generate:types:live": "openapi-typescript http://localhost:5000/api/openapi.json -o src/types/api-generated.ts",
    "generate:openapi": "curl -s http://localhost:5000/api/openapi.json -o ../openapi.json",
    "generate:all": "npm run generate:openapi && npm run generate:types"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.1.1",
    "@antv/g6": "^5.1.1",
    "@tanstack/react-query": "^5.99.0",
    "antd": "^6.3.5",
    "axios": "^1.15.0",
    "dayjs": "^1.11.11",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "madge": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.8"
  }
}
