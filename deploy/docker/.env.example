# ═══════════════════════════════════════════════════════════════════════════
# compose 专用环境变量样例
#   用法：cp deploy/docker/.env.example .env       # 落在仓库根，与 docker-compose.yml 同级
#
# 与仓库根 .env.example（285 行，生产向，MYSQL_HOST=localhost）是两份不同用途的文件：
#   · 根那份：本机直接跑 scripts/install.sh 时用，含连接池容量公式等完整说明，是权威清单；
#   · 这一份：compose 内各服务用**容器网络里的服务名**互相访问（mysql / redis），
#             只列 compose 场景下必须显式设置或必须**覆盖**的项。
# 配置项含义一律以根那份为准，此处不重复解释。
#
# ⚠️ 这里的三条口令都是本机可丢弃的 dev 值。评估完 `docker compose down -v` 即清空。
#    不要照搬到任何对外可见的环境。
# ═══════════════════════════════════════════════════════════════════════════

# ── 应用密钥 ───────────────────────────────────────────────────────────────
# ⚠️ 必须填随机值，四个都留空会启动失败（config.py:417 的 Config.validate 会抛
#    "SECRET_KEY 环境变量未设置，拒绝启动"）。
#    生成：for k in SECRET_KEY JWT_SECRET_KEY SWITCH_SECRET_KEY; do
#              printf '%s=%s\n' "$k" "$(openssl rand -hex 32)"; done
# ⚠️ 不要把占位符写成 change_me_xxx（下划线）—— 生产校验的判据是
#    startswith("change-me")（连字符，config.py:649），下划线形态**永远不会被拦**。
#    留空即可，留空一定会报错，比写错形态的占位符安全。
SECRET_KEY=
JWT_SECRET_KEY=
SWITCH_SECRET_KEY=

# 评估环境用 development：跳过 production 的 6 项门槛
# （SWITCH_SECRET_KEY 强校验 / CORS / DEBUG / 指标暴露 / 密钥重复 / LDAP CA）
FLASK_ENV=development
MONITOR_ENABLED=true
CORS_ORIGINS=http://localhost:8080

# ── 数据库（服务名，不是 localhost）─────────────────────────────────────────
# MYSQL_PASSWORD 必须与 docker-compose.yml 里 mysql 服务的默认值一致
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ipip
MYSQL_PASSWORD=ipip_dev_only
MYSQL_DATABASE=ip_management
# root 口令刻意**不**放在本文件（避免经 env_file 进入应用容器）；
# 要覆盖就用 shell 环境变量：MYSQL_ROOT_PASSWORD=xxx docker compose up -d
# MYSQL_ROOT_PASSWORD=ipip_root_dev_only

# ── Redis（服务名）─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Celery ⚠️ 必须显式覆盖，否则会指到容器自己的 localhost ─────────────────
# 根 .env.example 把这两项硬编码成 redis://localhost:6379/1|2，而 config.py:206-207
# 只在它们**未设置**时才从 REDIS_HOST 推导 ⇒ 不覆盖 = celery 连不上 broker，
# 表现为"AI 任务入库后毫无进展"。这里显式写成容器服务名。
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── 并发（决定连接池上界；公式见根 .env.example 的 A-P1-6 段注释）────────────
# 默认值下上界 = (4+2+4+1) × 30 = 330，mysql:8.4 官方镜像默认 max_connections=151，
# 但 330 是"所有进程同时打满溢出池"的理论上界，稳态远低于它 ⇒ 评估/开发场景无需调整。
# 真要顶着上限压测，先跑 scripts/check_db_pool_capacity.py 看实测。
GUNICORN_WORKERS=4
CELERY_AI_CONCURRENCY=2
CELERY_VOICE_CONCURRENCY=4

# ── 种子数据（一次性服务 seed 使用）──────────────────────────────────────
# 管理员账号由 migrations/seed_users.py 创建，密码只打印一次；
# 这里显式指定，避免装完就找不回密码。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ipip_dev_admin

# ── trapd（仅在 --profile trapd 启用时需要；默认整段保持注释）────────────────
# ⚠️ trapd（profile trapd 专用）：TRAPD_ENABLED 已由 compose 的服务 environment 注入（§5.5 ①），
#    此处只需填 COMMUNITIES。⚠️ 留空、或填 public/private，都会让容器**反复重启**（§5.5 ②）。
#    （退出循环），与 deploy/systemd 的约束同源。
# TRAPD_ENABLED=true
# TRAPD_COMMUNITIES=<强随机口令，例如 32 位随机串>   # 必须与交换机侧发送端一致
# TRAPD_HOST_PORT=162

# ── 镜像版本（决定 docker compose pull 拉哪个 tag）────────────────────────
# 由 GitHub Actions 在打 v* tag 时构建推送（见 §5.7）。
#   main   = 跟着 main 分支走（开箱即用，但内容会变）
#   1.0.2  = 锁定某个发布版本（评估建议用这个，避免"昨天还好、今天不一样"）
IPIP_IMAGE_TAG=main

# ── 宿主机端口映射 ────────────────────────────────────────────────────────
# HTTP_PORT 是唯一对外访问入口（nginx）。刻意**不放** 5000/8000 到宿主：
#   macOS 的 AirPlay Receiver 常占用 5000；且 web/gateway 无鉴权，不该直接暴露。
HTTP_PORT=8080
# 容器内部端口，一般不用改
FLASK_PORT=5000
GATEWAY_PORT=8000

# ── RAG（模型已**内置在镜像里**，这里不用做任何事）────────────────────────
# 镜像构建期已把两个模型预置到 HF_HOME（= /app/instance/huggingface）：
#   BAAI/bge-small-zh-v1.5   embedding  ≈91MB
#   BAAI/bge-reranker-base   reranker   ≈1060MB（缺失时检索仍可用，精排降级为 RRF）
# app/services/ai/rag/{embedding,reranker}.py 强制离线加载（HF_HUB_OFFLINE=1），
# 模型不在本地就是**加载失败**而非降级 ⇒ 内置是必需项，不是优化项。
# ⚠️ 不要在这里写 HF_HOME：env_file 会**覆盖**镜像里的 ENV，指到非镜像内路径
#    ⇒ 模型立刻"找不到"（RAG 静默失效）。要换路径请连模型一起挂载。
# ⚠️ 不要给 /app/instance 挂卷（理由见 compose 顶层 volumes 注释与 §9 R13）。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# 语料根目录，默认 /app/docs（镜像内已建好空目录 + 占位 README）。
# 想把语料放在别处再设它，并把该目录挂进容器。
# AI_DOCS_ROOT=/app/docs
