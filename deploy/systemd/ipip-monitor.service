; -*- coding: utf-8 -*-
; IPIP 设备健康监控采集服务（独立进程，asyncio 驱动）
;
; 替代 ipip-deploy/scripts/start.sh 的 start_monitor：
;   python run_monitor_service.py
;
; 说明：
; - 本服务通过 Redis 锁 monitor:lock:<loop> 与 in-Flask worker 互斥（见
;   app/services/monitoring/standalone_service.py），因此即便与其它实例
;   并存也不会双跑，但会浪费资源——生产仍应由本 unit 独占。
; - MONITOR_ENABLED 由 unit 自身控制：不需要此服务时执行
;   systemctl disable --now ipip-monitor.service，而不是靠环境变量跳过。

[Unit]
Description=IPIP device monitor collector
After=network.target mysql.service redis.service
; PartOf：让 ipip.target 的 stop/restart 传播到本服务（Wants= 不传播停止）。
PartOf=ipip.target

; ── 重启风暴抑制（[Unit] 段指令）─────────────────────────
; ⚠️ StartLimitBurst / StartLimitIntervalSec 属于 [Unit] 段，写在 [Service] 会被
;    systemd **静默忽略**（verify 报 "Unknown key name ... in section 'Service'"），
;    导致服务启动即崩时无限重启刷屏，抑制形同虚设。
; 300s 内崩溃 5 次即进入 failed 停止重试；该状态同时是上层失联告警的检测信号。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=ipip
Group=ipip

EnvironmentFile=/etc/ipip/ipip.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=${PROJECT_ROOT}

; ⚠️ 不要在这里硬编码 "production"：那会让本服务与其它 unit 走**不同的 config
;    解析路径**（其它 unit 都按 FLASK_ENV 解析）。实测踩到：.env 为 development
;    时，硬编码会把 monitor 单独送进 ProductionConfig.validate()，因缺
;    SWITCH_SECRET_KEY 而启动即崩、被 systemd 反复拉起（NRestarts 飙升）。
;    留空即跟随 FLASK_ENV，与 web/gateway/celery 保持一致。
ExecStart=${VENV_BIN}/python ${PROJECT_ROOT}/run_monitor_service.py

Restart=on-failure
RestartSec=10

; MONITOR_REDIS_DOWN_MODE 默认 skip（锁获取失败跳过本轮，避免与 in-Flask
; worker 双跑探测全部设备）。若确认部署形态无 in-Flask worker，可在
; /etc/ipip/ipip.env 中改为 execute，并在文档中记录该决定。

KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=control-group

NoNewPrivileges=true
PrivateTmp=true

; ── 安全加固（2026-09-11 评审遗留项整改：systemd 命名空间隔离）──
; 采集进程经 netmiko 写 logs/netmiko_*.log，并落轮转日志；instance/ 一并
; 放行以兼容可能的落盘（如 RAG/锁文件）。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${PROJECT_ROOT}/instance ${PROJECT_ROOT}/logs
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipip-monitor

[Install]
WantedBy=ipip.target
