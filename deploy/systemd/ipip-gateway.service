; -*- coding: utf-8 -*-
; IPIP realtime_gateway（SSE 推送网关，uvicorn ASGI）
;
; 替代 ipip-deploy/scripts/start.sh 的 start_gateway：
;   uvicorn realtime_gateway.main:app --host 0.0.0.0 --port 8000

[Unit]
Description=IPIP realtime_gateway (uvicorn, SSE)
Documentation=https://github.com/follow2015/IPIP/blob/main/deploy/systemd/README.md
After=network.target redis.service
; PartOf：让 ipip.target 的 stop/restart 传播到本服务（Wants= 不传播停止）。
PartOf=ipip.target

; ── 重启风暴抑制（[Unit] 段指令）─────────────────────────
; ⚠️ StartLimitBurst / StartLimitIntervalSec 属于 [Unit] 段，写在 [Service] 会被
;    systemd **静默忽略**（verify 报 "Unknown key name ... in section 'Service'"），
;    导致服务启动即崩时无限重启刷屏，抑制形同虚设。
; 300s 内崩溃 5 次即进入 failed 停止重试；该状态同时是上层失联告警的检测信号。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=ipip
Group=ipip

EnvironmentFile=/etc/ipip/ipip.env
WorkingDirectory=${PROJECT_ROOT}

; ⚠️ 不要加 --workers：SSE 连接上限（SSE_MAX_CONNECTIONS，默认 500）是**进程内**
;    计数（realtime_gateway/main.py 的 _ConnectionCounter）。加 --workers 4 就有
;    4 个互不可见的计数器，实际上限变成 500×4，且不会有任何报错 —— 超限拒绝
;    静默失效。要扩容必须先把计数换成跨进程实现（Redis + TTL 兜底），改完置
;    SSE_ALLOW_MULTI_WORKER=1 关掉启动自检告警。
;    本约束由 realtime_gateway/single_replica_guard.py 在启动时自检，结论同时
;    暴露在 /healthz 的 sse.single_replica，便于运维核对。
ExecStart=${VENV_BIN}/uvicorn realtime_gateway.main:app \
  --host 0.0.0.0 \
  --port ${GATEWAY_PORT} \
  --app-dir ${PROJECT_ROOT}

Restart=on-failure
RestartSec=10

KillSignal=SIGTERM
TimeoutStopSec=20
KillMode=control-group

NoNewPrivileges=true
PrivateTmp=true

; ── 安全加固（2026-09-11 评审遗留项整改：systemd 命名空间隔离）──
; 基准写盘路径 instance/ 与 logs/（日志轮转）保持可写；gateway 自身以
; 内存态 SSE 为主，多列的路径未来若新增落盘也不致起不来。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${PROJECT_ROOT}/instance ${PROJECT_ROOT}/logs
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipip-gateway

[Install]
WantedBy=ipip.target
