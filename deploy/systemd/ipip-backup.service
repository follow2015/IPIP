; -*- coding: utf-8 -*-
; IPIP 系统级备份（oneshot），由 ipip-backup.timer 每日触发。
;
; 对应 WBS 任务 T1：scripts/backup_system.py + scripts/restore_system.py
; ⚠️ 备份≠可恢复：首次上线后必须完成一次真实恢复演练（T1.8），否则本 unit
;    只是「定时产生一堆无法确认有效的文件」。

[Unit]
Description=IPIP system backup (mysql + instance)
; 本地备份不强依赖 Redis，但仍需 MySQL 在运行
After=mysql.service
; PartOf：让 ipip.target 的 stop 传播到本服务（备份由 timer 触发，此处仅保证
; 聚合停止时能一并停掉；backup.service 不进 ipip.target 的 Wants，避免开机自启
; 抢在 timer 之前重复跑）。

PartOf=ipip.target

[Service]
Type=oneshot
User=ipip
Group=ipip

EnvironmentFile=/etc/ipip/ipip.env
WorkingDirectory=${PROJECT_ROOT}

; ── 密钥导出（--include-secrets）─────────────────────────────
; GNUPGHOME：export_secrets 走 gpg 对称加密，而本单元 ProtectHome=true 会把
;   $HOME 换成空目录。更关键的是 —— gpg **不会自己创建 GNUPGHOME**：目录不存在
;   时直接报 `keyblock resource '.../pubring.kbx': No such file or directory`，
;   连带整次备份失败（真机实测）。故用 RuntimeDirectory 让 systemd 预先建好
;   一个 0700 目录；它位于 /run，在 ProtectSystem=strict 下仍可写，且随单元
;   结束自动清理 —— 顺带避免 gpg-agent socket 残留导致的挂起（见
;   backup_system.py 的 GPG_TIMEOUT_S 注释）。
RuntimeDirectory=ipip-backup-gnupg
RuntimeDirectoryMode=0700
Environment=GNUPGHOME=/run/ipip-backup-gnupg

; --include-secrets：把 .env 中的密钥（SWITCH_SECRET_KEY 等）GPG 对称加密导出为
;   <备份目录>/secrets.env.gpg，使整机损毁后 switch_credentials 密文仍可解。
;   口令取自 /etc/ipip/ipip.env 的 GPG_PASSPHRASE，**不随产物分发**，须离线另存。
;   ⚠️ 口令缺失/为空时整次备份失败（有意为之：不给"以为备了"的假象），故本单元
;   依赖该变量存在 —— 升级既有部署请先补写，见 docs/运维手册-备份与恢复.md。
; --prune：备份后按日7/周4/月3清理过期备份（见 scripts/backup_system.py）
ExecStart=${VENV_BIN}/python ${PROJECT_ROOT}/scripts/backup_system.py \
  --output-dir ${BACKUP_DIR} \
  --include-secrets \
  --prune

; ── 超时与重试 ───────────────────────────────────────────
; 大数据量 dump 可能较久，给足 1 小时；备份失败不重试，交给次日窗口 +
; 上层告警。watchdog（scripts/heartbeat_watchdog.py）会检查本 unit 的 Result
; 与上次结束时刻 —— 备份失败或长时间未跑都会告警，不会静默失效。
TimeoutStartSec=3600
Restart=no

PrivateTmp=true
NoNewPrivileges=true

; ── 安全加固（2026-09-11 评审遗留项整改：systemd 命名空间隔离）──
; ProtectSystem=strict 使全盘只读；备份产物写到 ${BACKUP_DIR}（默认
; /var/backups/ipip），临时凭据文件走 /tmp（由 PrivateTmp 提供的私有 tmpfs），
; 故 ReadWritePaths 需放行 BACKUP_DIR 与 logs/（备份自身日志）。instance/ 仅被
; 读取打包（dataface 数据面），一并列出无害。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${PROJECT_ROOT}/instance ${PROJECT_ROOT}/logs ${BACKUP_DIR}
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipip-backup
