# /etc/ipip/ipip.env —— systemd EnvironmentFile 模板（部署机复制并修改）
#
# ⚠️ 本文件只包含「部署形态」相关的少量变量，请勿把业务 .env 复制过来。
#
# 原因：
#   1. 业务配置由 config.py 的 load_dotenv() 从 ${PROJECT_ROOT}/.env 读取；
#   2. systemd EnvironmentFile 语法严格（不支持 export 前缀、部分引号与
#      特殊字符），直接套用业务 .env 会导致 unit 启动失败；
#   3. python-dotenv 依赖 cwd 定位 .env，故 unit 的 WorkingDirectory 必须是
#      项目根目录（已在各 unit 中设置）。
#
# 语法要求：每行 KEY=value，值不加引号、不支持变量展开、不支持命令替换。
# 修改后须执行 systemctl daemon-reload 并重启对应服务。

# ── 部署路径（必改）──────────────────────────────────────
PROJECT_ROOT=/opt/ipip
VENV_BIN=/opt/ipip/.venv/bin

# ── 端口 ─────────────────────────────────────────────────
FLASK_PORT=5000
GATEWAY_PORT=8000

# ── 备份目录 ─────────────────────────────────────────────
# 建议不同于 PROJECT_ROOT 所在盘（同盘故障会连同备份一起丢失）
BACKUP_DIR=/var/backups/ipip

# ── 并发 ─────────────────────────────────────────────────
GUNICORN_WORKERS=4
CELERY_AI_CONCURRENCY=2
CELERY_VOICE_CONCURRENCY=4

# ── 可选：仅在「确认部署形态无 in-Flask worker」时取消注释 ──
# 默认（注释掉）时监控服务在 Redis 锁获取失败会跳过本轮，避免双跑；
# 改为 execute 则允许本进程直接执行探测。
# MONITOR_REDIS_DOWN_MODE=execute

# ── 自监控（T2）───────────────────────────────────────────
# ⚠️ 不要把 HEARTBEAT_SERVICE_NAME 解注释放到这里！
#    本文件被所有 unit 共用，而 systemd 中 EnvironmentFile 会覆盖 unit 内的
#    Environment=。写在这里会让 monitor/gateway 也自称 web（心跳 key 互相覆盖，
#    比没有心跳更糟：一个进程活着就能掩盖另一个进程已死）。
#    正确做法是各 unit 内按自身身份声明，如 ipip-web.service 里的
#    Environment=HEARTBEAT_SERVICE_NAME=web。
#
# watchdog 健康检查基址，默认 http://127.0.0.1:5000（本机 Flask 端口）。
# 只有应用不监听本机回环（如走独立 Nginx 到别的端口/域名）时才需覆盖：
# WATCHDOG_BASE_URL=http://127.0.0.1:5000
