# /etc/ipip/ipip.env —— systemd EnvironmentFile 模板（部署机复制并修改）
#
# ⚠️ 本文件只包含「部署形态」相关的少量变量，请勿把业务 .env 复制过来。
#
# 原因：
#   1. 业务配置由 config.py 的 load_dotenv() 从 ${PROJECT_ROOT}/.env 读取；
#   2. systemd EnvironmentFile 语法严格（不支持 export 前缀、部分引号与
#      特殊字符），直接套用业务 .env 会导致 unit 启动失败；
#   3. python-dotenv 依赖 cwd 定位 .env，故 unit 的 WorkingDirectory 必须是
#      项目根目录（已在各 unit 中设置）。
#
# 语法要求：每行 KEY=value，值不加引号、不支持变量展开、不支持命令替换。
# 修改后须执行 systemctl daemon-reload 并重启对应服务。

# ── 部署路径（必改）──────────────────────────────────────
PROJECT_ROOT=/opt/ipip
VENV_BIN=/opt/ipip/.venv/bin

# ── 端口 ─────────────────────────────────────────────────
FLASK_PORT=5000
GATEWAY_PORT=8000

# ── 备份目录 ─────────────────────────────────────────────
# 建议不同于 PROJECT_ROOT 所在盘（同盘故障会连同备份一起丢失）
BACKUP_DIR=/var/backups/ipip

# ── 并发 ─────────────────────────────────────────────────
# ⚠️ 改这里就是改**数据库连接需求**（A-P1-6）：config.py 的池是
#    pool_size=10 + max_overflow=20 ⇒ **每个进程**最多 30 条连接，于是
#        峰值需求 = (GUNICORN_WORKERS + CELERY_AI_CONCURRENCY +
#                    CELERY_VOICE_CONCURRENCY + monitor 1 + 其他占池进程) × 30
#    默认值 4+2+4+1 = 11 进程 → **330 条**，已超 MySQL 默认 max_connections=151
#    （max_overflow 是按需创建，故这是上界、非稳态占用）。
#    改完请跑 `.venv/bin/python scripts/check_db_pool_capacity.py` —— 它读 MySQL
#    的 max_connections 实测对比
#    并给出 OK/WARN/FAIL（无库凭据时只报需求值）。
GUNICORN_WORKERS=4
CELERY_AI_CONCURRENCY=2
CELERY_VOICE_CONCURRENCY=4

# ── 监控采集：谁负责采（升级既有部署请确认）────────────────
# 采集职责**唯一**：由 ipip-monitor.service（run_monitor_service.py，headless 入口）
# 独占；ipip-web / ipip-celery-ai / ipip-celery-voice 单元内已各自声明
# Environment=MONITOR_WORKER_IN_PROCESS=false。
#
# ⚠️ 三条容易踩的：
#   1. **不要**在本文件里写 MONITOR_WORKER_IN_PROCESS=true。systemd 中
#      EnvironmentFile 会**覆盖** unit 内的 Environment=，等于把各 unit 里的 false
#      静默废掉，回到"多进程并发采集"：4 个 gunicorn worker + celery 各起一套轮询
#      线程，而 Redis 锁只保证互斥、不保证限速 ⇒ 聚合频率 = interval ÷ 实例数
#      （独立实测：配置 60 s，库里有效周期 18.9 s）。
#   2. **既有部署**：本文件是「已存在则不覆盖」，只有单元文件会被 install-units.sh
#      重装。升级到含本次修复的版本后，请重跑 deploy/systemd/install-units.sh
#      并重启 ipip.target，否则存量机仍处于并发采集状态。
#   3. 若你**故意**让 web 进程采集（例如只装 web、不装 ipip-monitor.service），
#      就在对应 unit 里显式改回 true，并接受频率被 worker 数放大（可同时把
#      GUNICORN_WORKERS 设为 1 缓解）。
#
# 运行期判据（不依赖配置是否正确）—— GET /metrics：
#   ipip_monitor_round_writers{loop=...}  > 1  ⇒ 同 loop 有多实例并发
#   ipip_monitor_round_skipped_total      在涨 ⇒ 最小间隔闸门正在拦（说明确有争用）
#   ipip_monitor_rounds_per_minute  明显高于配置频率 ⇒ 仍在放大
#
# ── 可选：仅在「确认部署形态无 in-Flask worker」时取消注释 ──
# 默认（注释掉）时监控服务在 Redis 锁获取失败会跳过本轮，避免双跑；
# 改为 execute 则允许本进程直接执行探测。
# MONITOR_REDIS_DOWN_MODE=execute
#
# 最小间隔闸门（限速器）总开关，默认 true —— 保证同 loop 的全部实例共享一个
# interval 配额。置 false 仅用于现场排障，或需要立刻跑一轮时（代价：回到
# "聚合频率 = interval ÷ 实例数"）。
# MONITOR_RATE_LIMIT_ENABLED=false

# ── 自监控（T2）───────────────────────────────────────────
# ⚠️ 不要把 HEARTBEAT_SERVICE_NAME 解注释放到这里！
#    本文件被所有 unit 共用，而 systemd 中 EnvironmentFile 会覆盖 unit 内的
#    Environment=。写在这里会让 monitor/gateway 也自称 web（心跳 key 互相覆盖，
#    比没有心跳更糟：一个进程活着就能掩盖另一个进程已死）。
#    正确做法是各 unit 内按自身身份声明，如 ipip-web.service 里的
#    Environment=HEARTBEAT_SERVICE_NAME=web。
#
# watchdog 健康检查基址，默认 http://127.0.0.1:5000（本机 Flask 端口）。
# 只有应用不监听本机回环（如走独立 Nginx 到别的端口/域名）时才需覆盖：
# WATCHDOG_BASE_URL=http://127.0.0.1:5000

# ── 备份：密钥导出（GPG）────────────────────────────────────
# ipip-backup.service 以 --include-secrets 运行：每次备份会把 .env 中的密钥
# （SWITCH_SECRET_KEY 等）AES256 对称加密导出为 <备份目录>/secrets.env.gpg，
# 使整机损毁后 switch_credentials 密文仍可解。
#
# ⚠️ 三条硬约束：
#   1. **口令必须离线另存**（密码管理器 / 纸质）。它不随备份产物走，丢失则所有
#      secrets.env.gpg 永久不可解 —— 与「备份没做」等价。
#   2. 必须是**强随机**串。空值等于没加密，脚本会直接拒绝并让整次备份失败
#      （有意为之：不制造「以为备了」的假象）。
#   3. 本文件含密钥，权限须 0600。
#
# 新装机由 install-units.sh 自动生成并打印一次；**既有部署升级请手工补写本行**。
GPG_PASSPHRASE=

# ── BREAKING CHANGES 提示（WP-4，2026-09-23）──────────────────
# 本文件只含部署形态变量；**业务密钥在 ${PROJECT_ROOT}/.env**。
# 升级后 ProductionConfig.validate 为 fail-fast：配置缺失时 5 个单元
# 重启连环失败。restart 前必跑离线预检（只读、不启动服务）：
#   /opt/ipip/.venv/bin/python /opt/ipip/scripts/precheck_prod_config.py \
#       --env-file /opt/ipip/.env
# 退出 0 才 systemctl restart ipip.target。必填清单见仓库 .env.example 同名段。
