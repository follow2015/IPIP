; -*- coding: utf-8 -*-
; IPIP Celery worker —— 语音通知队列
;
; 语音时延敏感（单次呼叫 + 等回调窗口），与 AI 长任务物理隔离，
; 避免 prefork 池被占满时排队。并发 4 足够覆盖低频告警场景。
; 队列拆分决策见 docs/adr-003-进程托管形态.md。

[Unit]
Description=IPIP celery worker (queue: voice)
After=network.target mysql.service redis.service
; PartOf：让 ipip.target 的 stop/restart 传播到本服务（Wants= 不传播停止）。
PartOf=ipip.target

; ── 重启风暴抑制（[Unit] 段指令）─────────────────────────
; ⚠️ StartLimitBurst / StartLimitIntervalSec 属于 [Unit] 段，写在 [Service] 会被
;    systemd **静默忽略**（verify 报 "Unknown key name ... in section 'Service'"），
;    导致服务启动即崩时无限重启刷屏，抑制形同虚设。
; 300s 内崩溃 5 次即进入 failed 停止重试；该状态同时是上层失联告警的检测信号。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=ipip
Group=ipip

EnvironmentFile=/etc/ipip/ipip.env
Environment=AI_ASYNC_ENABLED=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=${PROJECT_ROOT}

ExecStart=${VENV_BIN}/celery -A app.celery_app.celery worker \
  -Q voice \
  --concurrency=${CELERY_VOICE_CONCURRENCY} \
  --loglevel=info

Restart=on-failure
RestartSec=10

; 语音 task 软超时 45s；此处给足等待余量让当前呼叫完成。
KillSignal=SIGTERM
TimeoutStopSec=120
KillMode=control-group

NoNewPrivileges=true
PrivateTmp=true

; ── 安全加固（2026-09-11 评审遗留项整改：systemd 命名空间隔离）──
; instance/ 含 RAG chroma/FTS 与定时任务锁文件；logs/ 含轮转日志与
; netmiko 设备 I/O 日志，均需在 ProtectSystem=strict 下保持可写。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${PROJECT_ROOT}/instance ${PROJECT_ROOT}/logs
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipip-celery-voice

[Install]
WantedBy=ipip.target
