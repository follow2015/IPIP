; -*- coding: utf-8 -*-
; IPIP Celery worker —— AI 异步任务队列
;
; ⚠️ 队列语义变更（ADR-003 决策）：
;   由 start.sh 的「单 worker -Q ai,voice」改为与 deploy/supervisord.conf
;   一致的「AI / 语音双 worker 物理隔离」，避免语音呼叫被 AI agentic
;   长任务（time_limit=1800s）饿死。详见 deploy/supervisord.conf:47-48。

[Unit]
Description=IPIP celery worker (queue: ai)
After=network.target mysql.service redis.service

; ── 重启风暴抑制（[Unit] 段指令）─────────────────────────
; ⚠️ StartLimitBurst / StartLimitIntervalSec 属于 [Unit] 段，写在 [Service] 会被
;    systemd **静默忽略**（verify 报 "Unknown key name ... in section 'Service'"），
;    导致服务启动即崩时无限重启刷屏，抑制形同虚设。
; 300s 内崩溃 5 次即进入 failed 停止重试；该状态同时是上层失联告警的检测信号。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=ipip
Group=ipip

EnvironmentFile=/etc/ipip/ipip.env
; dotenv 不覆盖已存在的环境变量，故此处显式置位等价于「部署级 env > .env」
; 的优先级（与 deploy/supervisord.conf:59 的做法一致）。
Environment=AI_ASYNC_ENABLED=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=${PROJECT_ROOT}

ExecStart=${VENV_BIN}/celery -A app.celery_app.celery worker \
  -Q ai \
  --concurrency=${CELERY_AI_CONCURRENCY} \
  --loglevel=info

Restart=on-failure
RestartSec=10

; ── warm shutdown ────────────────────────────────────────
; 等当前任务跑完：agentic 最长 30min，此处给 1800s 上限，超时才 SIGKILL。
; 硬中断兜底由 task 自身的 time_limit 保证。
KillSignal=SIGTERM
TimeoutStopSec=1800
; celery prefork 有子进程，必须杀整个进程组，否则遗留孤儿 worker 池
; （宿主机实测：孤儿存活且同名，新 worker ready 但不消费）。
KillMode=control-group

NoNewPrivileges=true
PrivateTmp=true
MemoryMax=4G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipip-celery-ai

[Install]
WantedBy=ipip.target
